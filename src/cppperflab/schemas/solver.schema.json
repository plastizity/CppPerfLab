{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:cppperflab:solver:1",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "residual_norm": {
      "enum": [
        "l2_absolute",
        "l2_relative"
      ]
    },
    "termination": {
      "enum": [
        "converged",
        "max_iterations",
        "breakdown"
      ]
    },
    "iterations": {
      "type": "integer",
      "minimum": 0
    },
    "residual_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "solution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "number"
      }
    },
    "setup_seconds": {
      "type": "number",
      "minimum": 0
    },
    "solve_seconds": {
      "type": "number",
      "minimum": 0
    },
    "total_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "schema_version",
    "problem_id",
    "residual_norm",
    "termination",
    "iterations",
    "residual_history",
    "solution",
    "setup_seconds",
    "solve_seconds",
    "total_seconds"
  ]
}
