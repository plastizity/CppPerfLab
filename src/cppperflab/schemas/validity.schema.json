{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:validity:1",
  "title": "CppPerfLab condition-backed claim validity v1",
  "description": "The status covers only recorded checks, not causal proof or production adoption.",
  "type": "object",
  "required": ["schema_version", "status", "assessment_scope", "claim_kind", "claim", "conditions", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["NOT_CONFIGURED", "PASS", "FAIL", "INCONCLUSIVE", "UNSUPPORTED"]},
    "assessment_scope": {"enum": ["none", "claim", "execution_state"]},
    "claim_kind": {"enum": ["task_cost", "unit_efficiency", "mechanism_hypothesis", null]},
    "claim": {"type": ["object", "null"]},
    "claim_applicable": {"type": ["boolean", "null"], "description": "Whether this comparison evaluates the declared primary metric and scope; null for runs or no claim."},
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "origin", "source", "required", "status", "evidence_refs", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "origin": {"enum": ["platform", "declared"]},
          "source": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "UNSUPPORTED"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
