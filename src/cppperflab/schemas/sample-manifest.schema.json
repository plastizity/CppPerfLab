{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:sample-manifest:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json",
                  "binary"
                ]
              },
              "format_version": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "format",
              "format_version"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "path"
                ],
                "not": {
                  "required": [
                    "value"
                  ]
                }
              },
              {
                "required": [
                  "value"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                },
                "properties": {
                  "format": {
                    "enum": [
                      "text",
                      "json"
                    ]
                  }
                }
              }
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "format": {
                      "const": "text"
                    }
                  },
                  "required": [
                    "value"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "expected": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json",
                  "binary"
                ]
              },
              "format_version": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name",
                    "path"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "format",
              "format_version"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "path"
                ],
                "not": {
                  "required": [
                    "value"
                  ]
                }
              },
              {
                "required": [
                  "value"
                ],
                "not": {
                  "required": [
                    "path"
                  ]
                },
                "properties": {
                  "format": {
                    "enum": [
                      "text",
                      "json"
                    ]
                  }
                }
              }
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "format": {
                      "const": "text"
                    }
                  },
                  "required": [
                    "value"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "input_complete": {
            "const": true
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "correctness": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "observation": {
            "type": "object",
            "properties": {
              "duration_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "evidence_state": {
                "enum": [
                  "Measured",
                  "Estimated",
                  "Modeled",
                  "Unsupported",
                  "Missing",
                  "Invalid"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "duration_seconds",
              "evidence_state"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "evidence_state": {
                      "enum": [
                        "Measured",
                        "Estimated",
                        "Modeled"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "duration_seconds": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "else": {
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "duration_seconds": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "sample_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "phase_id": {
                "type": "string",
                "minLength": 1
              },
              "execution_stage": {
                "enum": [
                  "measurement",
                  "preflight"
                ]
              }
            },
            "required": [
              "run_id",
              "sample_index",
              "phase_id"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "execution_stage"
                  ],
                  "properties": {
                    "execution_stage": {
                      "const": "preflight"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sample_index": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "sample_index": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            ]
          },
          "input_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "input",
          "input_complete",
          "result",
          "correctness"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "source"
            ]
          },
          {
            "required": [
              "observation"
            ]
          }
        ]
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "all",
            "longest_per_result",
            "random_per_result"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "limit_per_result": {
          "type": "integer",
          "minimum": 1
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "all"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "seed"
                  ]
                },
                {
                  "required": [
                    "limit_per_result"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "seed",
              "limit_per_result"
            ]
          }
        }
      ]
    },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "name",
    "samples",
    "selection",
    "max_payload_bytes"
  ],
  "additionalProperties": false
}
