{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:phase-summary:1",
  "title": "CppPerfLab caller-reported phase summary",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "representation": {"const": "summary"},
    "scope": {"type": "string", "minLength": 1},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "source": {
      "type": "object",
      "properties": {
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_sha256": {"$ref": "#/$defs/sha256"},
        "input_lines": {"type": "integer", "minimum": 0},
        "matched_lines": {"type": "integer", "minimum": 0},
        "ignored_lines": {"type": "integer", "minimum": 0},
        "source_path": {"type": "string", "minLength": 1},
        "mapping_path": {"type": "string", "minLength": 1}
      },
      "required": ["input_sha256", "mapping_sha256", "input_lines", "matched_lines", "ignored_lines", "source_path", "mapping_path"],
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "representation", "scope", "stages", "source"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {
      "type": "object",
      "properties": {"seconds": {"type": "number", "minimum": 0}, "evidence_state": {"enum": ["Measured", "Estimated"]}},
      "required": ["seconds", "evidence_state"],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {"value": {"type": "number", "minimum": 0}, "unit": {"type": "string", "minLength": 1}, "evidence_state": {"enum": ["Measured", "Estimated", "Modeled"]}},
      "required": ["value", "unit", "evidence_state"],
      "additionalProperties": false
    },
    "source_lines": {
      "type": "object",
      "properties": {"count": {"type": "integer", "minimum": 0}, "first": {"type": ["integer", "null"], "minimum": 1}, "last": {"type": ["integer", "null"], "minimum": 1}},
      "required": ["count", "first", "last"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"count": {"const": 0}}, "required": ["count"]}, "then": {"properties": {"first": {"type": "null"}, "last": {"type": "null"}}}},
        {"if": {"properties": {"count": {"minimum": 1}}, "required": ["count"]}, "then": {"properties": {"first": {"type": "integer", "minimum": 1}, "last": {"type": "integer", "minimum": 1}}}}
      ]
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "inclusive": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "self": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "calls": {"type": ["integer", "null"], "minimum": 0},
        "correctness": {"enum": ["passed", "failed", "not_checked"]},
        "children_coverage": {"enum": ["unknown", "complete_nonoverlapping"]},
        "work": {"type": "object", "additionalProperties": {"$ref": "#/$defs/work"}},
        "source_lines": {"$ref": "#/$defs/source_lines"}
      },
      "required": ["id", "name", "parent_id", "inclusive", "self", "calls", "correctness", "children_coverage", "work", "source_lines"],
      "additionalProperties": false
    }
  }
}
