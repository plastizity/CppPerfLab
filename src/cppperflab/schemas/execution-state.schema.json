{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:execution-state:1",
  "title": "CppPerfLab execution state declaration v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scope": {
      "enum": [
        "measurement_invocation",
        "measurement_sample"
      ]
    },
    "process": {
      "const": "fresh_process"
    },
    "object_state": {
      "type": "string",
      "minLength": 1
    },
    "cache": {
      "enum": [
        "uncontrolled",
        "cold",
        "warm"
      ]
    },
    "external_state": {
      "type": "string",
      "minLength": 1
    },
    "required": {
      "type": "boolean"
    },
    "setup": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "reset": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "verify": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "argv"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scope",
    "process",
    "object_state",
    "cache",
    "external_state",
    "required"
  ],
  "additionalProperties": false
}
