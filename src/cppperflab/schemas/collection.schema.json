{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:collection:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "collection_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "capturing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "all",
            "longest_per_result",
            "random_per_result"
          ]
        },
        "seed": {
          "type": "integer"
        },
        "limit_per_result": {
          "type": "integer",
          "minimum": 1
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "all"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "seed"
                  ]
                },
                {
                  "required": [
                    "limit_per_result"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "seed",
              "limit_per_result"
            ]
          }
        }
      ]
    },
    "max_payload_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "input_complete": {
            "const": true
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "correctness": {
            "enum": [
              "passed",
              "failed",
              "not_checked"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "observation": {
            "type": "object",
            "properties": {
              "duration_seconds": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "evidence_state": {
                "enum": [
                  "Measured",
                  "Estimated",
                  "Modeled",
                  "Unsupported",
                  "Missing",
                  "Invalid"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "object"
              }
            },
            "required": [
              "duration_seconds",
              "evidence_state"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "evidence_state": {
                      "enum": [
                        "Measured",
                        "Estimated",
                        "Modeled"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "duration_seconds": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "else": {
                  "required": [
                    "reason"
                  ],
                  "properties": {
                    "duration_seconds": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "captured": {
            "type": "boolean"
          },
          "input": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json",
                  "binary"
                ]
              },
              "format_version": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "bytes",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "format",
              "format_version",
              "entry",
              "files"
            ],
            "additionalProperties": false
          },
          "expected": {
            "type": "object",
            "properties": {
              "format": {
                "enum": [
                  "text",
                  "json",
                  "binary"
                ]
              },
              "format_version": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "bytes",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "format",
              "format_version",
              "entry",
              "files"
            ],
            "additionalProperties": false
          },
          "input_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "input_complete",
          "result",
          "correctness",
          "tags",
          "observation",
          "captured"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "captured": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "input"
              ]
            }
          }
        ]
      }
    },
    "selected_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "collection_id",
    "name",
    "status",
    "started_at",
    "selection",
    "max_payload_bytes",
    "payload_bytes",
    "samples",
    "selected_ids",
    "source_manifest_sha256",
    "error",
    "limitations",
    "evidence"
  ],
  "additionalProperties": false
}
