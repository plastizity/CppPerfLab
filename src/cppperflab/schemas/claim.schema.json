{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:claim:1",
  "title": "CppPerfLab performance claim v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "task_cost",
        "unit_efficiency",
        "mechanism_hypothesis"
      ]
    },
    "applies_to": {
      "type": "string",
      "minLength": 1
    },
    "allowed_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "metric_scope": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "declaration",
              "correctness",
              "execution_state",
              "work_metric"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "metric_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "source",
          "required"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "work_metric"
                }
              }
            },
            "then": {
              "required": [
                "metric"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "metric"
                    ]
                  },
                  {
                    "required": [
                      "metric_scope"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "hypothesis",
    "kind",
    "applies_to",
    "allowed_changes",
    "metric",
    "conditions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "unit_efficiency"
          }
        }
      },
      "then": {
        "properties": {
          "conditions": {
            "contains": {
              "type": "object",
              "properties": {
                "source": {
                  "const": "work_metric"
                },
                "required": {
                  "const": true
                }
              },
              "required": [
                "source",
                "required"
              ]
            }
          }
        }
      }
    }
  ]
}
