{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:result:1",
  "title": "CppPerfLab result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "timeout",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "parameters",
            "inputs"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "cwd": {
              "type": "string"
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "build": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string"
                },
                "compiler": {
                  "type": "string"
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "mode": {
                  "type": "string"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "revision",
                "compiler",
                "flags",
                "mode",
                "artifacts"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "argv",
            "environment",
            "build"
          ],
          "additionalProperties": false
        },
        "measurement": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "repetitions": {
              "type": "integer",
              "minimum": 1
            },
            "warmups": {
              "type": "integer",
              "minimum": 0
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cpu_affinity": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1
            },
            "options": {
              "type": "object"
            },
            "limits": {
              "type": "object",
              "properties": {
                "address_space_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "cpu_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "tool",
            "repetitions",
            "warmups",
            "timeout_seconds",
            "options"
          ],
          "additionalProperties": false
        },
        "correctness": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "argv",
            "description"
          ],
          "additionalProperties": false
        },
        "goal": {
          "type": "object",
          "properties": {
            "metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "max_overhead": {
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            },
            "allow_instrumentation": {
              "type": "boolean"
            }
          },
          "required": [
            "metrics",
            "max_overhead",
            "allow_instrumentation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "name",
        "workload",
        "target",
        "measurement",
        "correctness"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "value_type": {
                  "enum": [
                    "integer",
                    "number"
                  ]
                },
                "status": {
                  "const": "observed"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "tool_version": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_state": {
                  "enum": [
                    "Measured",
                    "Estimated",
                    "Modeled"
                  ]
                },
                "evidence_version": {
                  "const": 1
                }
              },
              "required": [
                "name",
                "value",
                "unit",
                "method",
                "scope",
                "value_type",
                "status",
                "evidence",
                "tool",
                "tool_version"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "index",
          "metrics"
        ],
        "additionalProperties": false
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "correctness": {
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            },
            "exit_code": {
              "type": "integer"
            }
          },
          "required": [
            "category",
            "message",
            "details",
            "exit_code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence_directory": {
      "type": "string",
      "minLength": 1
    },
    "derived_observations": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "unavailable_observations": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "call_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allocation_sites": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "request",
    "environment",
    "samples",
    "hotspots",
    "summary",
    "correctness",
    "error",
    "evidence_directory"
  ],
  "additionalProperties": true
}
