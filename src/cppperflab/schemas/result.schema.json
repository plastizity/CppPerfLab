{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:result:1",
  "title": "CppPerfLab result v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}-[0-9a-f]{12}$"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "timeout",
        "cancelled"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "execution_context": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["concurrent_ab", "serial"]},
        "concurrent_runs": {"const": 2},
        "competition_pair_identity": {
          "type": "object",
          "properties": {
            "baseline": {"type": "object"},
            "candidate": {"type": "object"}
          },
          "required": ["baseline", "candidate"],
          "additionalProperties": false
        },
        "resource_conditions": {"type": "object"},
        "scope": {"type": "string", "minLength": 1},
        "status": {"const": "PASS"},
        "overlap_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "overlap": {"type": "object"}
      },
      "required": ["kind"],
      "allOf": [{
        "if": {"properties": {"kind": {"const": "concurrent_ab"}}, "required": ["kind"]},
        "then": {"required": ["concurrent_runs", "competition_pair_identity", "resource_conditions"]}
      }],
      "additionalProperties": true
    },
    "workflow_cost": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "method": {
          "const": "monotonic-run-lifetime"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "started_monotonic_ns": {
          "type": "integer",
          "minimum": 0
        },
        "clock": {
          "type": "object",
          "properties": {
            "name": {
              "const": "CLOCK_MONOTONIC"
            },
            "boot_id": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "time_namespace": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "context_reason": {
              "type": "string"
            }
          },
          "required": ["name", "boot_id", "time_namespace"],
          "additionalProperties": false
        },
        "owner": {
          "$ref": "#/definitions/identity"
        },
        "cost_key": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "elapsed_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "evidence_state": {
          "enum": ["Measured", "Invalid"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version", "method", "scope", "started_monotonic_ns",
        "clock", "cost_key", "implementation_sha256", "elapsed_seconds",
        "evidence_state"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "workload": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expected_hashes": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "required": [
            "id",
            "parameters",
            "inputs"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "cwd": {
              "type": "string"
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "build": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string"
                },
                "compiler": {
                  "type": "string"
                },
                "flags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "mode": {
                  "type": "string"
                },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "revision",
                "compiler",
                "flags",
                "mode",
                "artifacts"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "argv",
            "environment",
            "build"
          ],
          "additionalProperties": false
        },
        "measurement": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "repetitions": {
              "type": "integer",
              "minimum": 1
            },
            "warmups": {
              "type": "integer",
              "minimum": 0
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "progress": {
              "type": "boolean",
              "description": "Opt-in lifecycle writes. Actual process metadata writes may overlap target runtime; plan overhead as high."
            },
            "cpu_affinity": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1
            },
            "options": {
              "type": "object"
            },
            "limits": {
              "type": "object",
              "properties": {
                "address_space_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "cpu_seconds": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "phase_report": {
              "type": "string",
              "pattern": "^[^/\\\\\\u0000]+\\.phases\\.json$"
            },
            "runtime_identity": {
              "type": "object",
              "properties": {
                "stages": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "preflight",
                      "measurement"
                    ]
                  }
                },
                "interval_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_snapshots": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_processes": {
                  "type": "integer",
                  "minimum": 1
                },
                "required_objects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "basename": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "basename",
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "stages",
                "interval_ms",
                "max_snapshots",
                "max_processes"
              ],
              "additionalProperties": false
            },
            "phase_import": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "mapping": {
                  "type": "string",
                  "minLength": 1
                },
                "mapping_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source",
                "mapping"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "tool",
            "repetitions",
            "warmups",
            "timeout_seconds",
            "options"
          ],
          "additionalProperties": false
        },
        "correctness": {
          "type": "object",
          "properties": {
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sample_validation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argv",
                "report",
                "residual_norm",
                "max_residual",
                "max_absolute_error",
                "max_relative_error",
                "max_iterations"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "report": {
                  "type": "string",
                  "minLength": 1
                },
                "residual_norm": {
                  "enum": [
                    "l2_absolute",
                    "l2_relative"
                  ]
                },
                "max_iterations": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_residual": {
                  "type": "number",
                  "minimum": 0
                },
                "max_absolute_error": {
                  "type": "number",
                  "minimum": 0
                },
                "max_relative_error": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "required": [
            "argv",
            "description"
          ],
          "additionalProperties": false
        },
        "goal": {
          "type": "object",
          "properties": {
            "metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "max_overhead": {
              "enum": [
                "low",
                "moderate",
                "high"
              ]
            },
            "allow_instrumentation": {
              "type": "boolean"
            }
          },
          "required": [
            "metrics",
            "max_overhead",
            "allow_instrumentation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "name",
        "workload",
        "target",
        "measurement",
        "correctness"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object"
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "value_type": {
                  "enum": [
                    "integer",
                    "number"
                  ]
                },
                "status": {
                  "const": "observed"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "tool_version": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_state": {
                  "enum": [
                    "Measured",
                    "Estimated",
                    "Modeled"
                  ]
                },
                "evidence_version": {
                  "const": 1
                }
              },
              "required": [
                "name",
                "value",
                "unit",
                "method",
                "scope",
                "value_type",
                "status",
                "evidence",
                "tool",
                "tool_version"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "index",
          "metrics"
        ],
        "additionalProperties": false
      }
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "correctness": {
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object"
            },
            "exit_code": {
              "type": "integer"
            }
          },
          "required": [
            "category",
            "message",
            "details",
            "exit_code"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence_directory": {
      "type": "string",
      "minLength": 1
    },
    "derived_observations": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "unavailable_observations": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "call_edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "allocation_sites": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "execution_stage": {
            "enum": [
              "preflight",
              "measurement"
            ]
          },
          "sample": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "runtime_identities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sampling_profiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scheduler_timelines": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Optional versioned profiles following scheduler-timeline.schema.json; absent means no such profile was requested or archived."
    },
    "sampling_precheck": {
      "type": "object"
    },
    "phase_clocks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lifecycle": {
      "$ref": "#/definitions/lifecycle"
    },
    "thread_timelines": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Per-launch application activity summaries; detailed source intervals are loaded through timeline queries"
    },
    "phase_summaries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "phase_imports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "started_at",
    "request",
    "environment",
    "samples",
    "hotspots",
    "summary",
    "correctness",
    "error",
    "evidence_directory"
  ],
  "additionalProperties": true,
  "definitions": {
    "identity": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "start_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "boot_id": {
          "type": "string",
          "minLength": 1
        },
        "pid_namespace": {
          "type": "string",
          "minLength": 1
        },
        "process_state": {
          "type": "string",
          "minLength": 1
        },
        "evidence_state": {
          "enum": [
            "Measured",
            "Unsupported",
            "Missing"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "pid",
        "evidence_state"
      ],
      "additionalProperties": true
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "owner": {
          "$ref": "#/definitions/identity"
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "active_process": {
          "type": [
            "object",
            "null"
          ]
        },
        "launches": {
          "type": "object"
        },
        "measurement_groups": {
          "type": "object"
        },
        "normalized_samples": {
          "type": "integer",
          "minimum": 0
        },
        "eta": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "owner",
        "stage",
        "updated_at",
        "active_process",
        "launches",
        "measurement_groups",
        "normalized_samples",
        "eta"
      ],
      "additionalProperties": false
    }
  }
}
