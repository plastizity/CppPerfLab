{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:request:1",
  "title": "CppPerfLab request v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "required": [
        "id",
        "parameters",
        "inputs"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "build": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string"
            },
            "compiler": {
              "type": "string"
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "revision",
            "compiler",
            "flags",
            "mode",
            "artifacts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "argv",
        "environment",
        "build"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "progress": {
          "type": "boolean",
          "description": "Opt-in lifecycle writes. Actual process metadata writes may overlap target runtime; plan overhead as high."
        },
        "cpu_affinity": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "options": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "properties": {
            "address_space_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "cpu_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "phase_report": {
          "type": "string",
          "pattern": "^[^/\\\\\\u0000]+\\.phases\\.json$"
        },
        "runtime_identity": {
          "type": "object",
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "preflight",
                  "measurement"
                ]
              }
            },
            "interval_ms": {
              "type": "integer",
              "minimum": 1
            },
            "max_snapshots": {
              "type": "integer",
              "minimum": 1
            },
            "max_processes": {
              "type": "integer",
              "minimum": 1
            },
            "required_objects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "basename": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "basename",
                  "path",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "stages",
            "interval_ms",
            "max_snapshots",
            "max_processes"
          ],
          "additionalProperties": false
        },
        "phase_import": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "mapping": {
              "type": "string",
              "minLength": 1
            },
            "mapping_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "source",
            "mapping"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "repetitions",
        "warmups",
        "timeout_seconds",
        "options"
      ],
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sample_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "argv",
            "report",
            "residual_norm",
            "max_residual",
            "max_absolute_error",
            "max_relative_error",
            "max_iterations"
          ],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "residual_norm": {
              "enum": [
                "l2_absolute",
                "l2_relative"
              ]
            },
            "max_iterations": {
              "type": "integer",
              "minimum": 1
            },
            "max_residual": {
              "type": "number",
              "minimum": 0
            },
            "max_absolute_error": {
              "type": "number",
              "minimum": 0
            },
            "max_relative_error": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "required": [
        "argv",
        "description"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "max_overhead": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "allow_instrumentation": {
          "type": "boolean"
        }
      },
      "required": [
        "metrics",
        "max_overhead",
        "allow_instrumentation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "name",
    "workload",
    "target",
    "measurement",
    "correctness"
  ],
  "additionalProperties": false
}
