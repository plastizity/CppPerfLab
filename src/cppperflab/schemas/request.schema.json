{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:request:1",
  "title": "CppPerfLab request v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "parameters",
        "inputs"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "build": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "string"
            },
            "compiler": {
              "type": "string"
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "type": "string"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "revision",
            "compiler",
            "flags",
            "mode",
            "artifacts"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "argv",
        "environment",
        "build"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpu_affinity": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "options": {
          "type": "object"
        },
        "limits": {
          "type": "object",
          "properties": {
            "address_space_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "cpu_seconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "tool",
        "repetitions",
        "warmups",
        "timeout_seconds",
        "options"
      ],
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "argv",
        "description"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "max_overhead": {
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "allow_instrumentation": {
          "type": "boolean"
        }
      },
      "required": [
        "metrics",
        "max_overhead",
        "allow_instrumentation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "name",
    "workload",
    "target",
    "measurement",
    "correctness"
  ],
  "additionalProperties": false
}
