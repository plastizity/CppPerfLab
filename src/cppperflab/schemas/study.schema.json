{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:study:1",
  "title": "CppPerfLab study v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "axis": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "argument_index": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "parameter",
        "values",
        "argument_index"
      ],
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "executable",
          "revision",
          "artifacts"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "string",
      "minLength": 1
    },
    "secondary_metrics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "template",
    "axis",
    "variants",
    "budget",
    "seed",
    "metric",
    "constraints"
  ],
  "additionalProperties": false
}
