{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:workflow:1",
  "title": "CppPerfLab study workflow declaration v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "phase": {
      "enum": [
        "exploration",
        "calibration",
        "confirmation",
        "acceptance"
      ]
    },
    "source_study_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "selected_run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "source_study_ids",
    "selection_reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "confirmation",
              "acceptance"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_study_ids": {
            "minItems": 1
          }
        },
        "required": [
          "selected_run_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "selected_run_id"
          ]
        }
      }
    }
  ]
}
