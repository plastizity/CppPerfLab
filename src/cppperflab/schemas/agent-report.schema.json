{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cppperflab:agent-report:1",
  "title": "CppPerfLab compact agent report v1",
  "description": "Projection of a shared analysis view; selection counts show omitted regular detail and source evidence remains authoritative.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_type": {
      "const": "agent"
    },
    "record_id": {
      "type": "string"
    },
    "view_kind": {
      "enum": [
        "run",
        "study",
        "comparison",
        "summary"
      ]
    },
    "status": {
      "type": "string"
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "required": [
        "category",
        "message",
        "exit_code"
      ],
      "additionalProperties": false
    },
    "optimization_accepted": {
      "const": false
    },
    "subject": {
      "type": "object"
    },
    "assessment": {
      "type": [
        "object",
        "null"
      ]
    },
    "comparisons": {
      "$ref": "#/$defs/collection"
    },
    "metrics": {
      "$ref": "#/$defs/collection"
    },
    "hotspots": {
      "$ref": "#/$defs/collection"
    },
    "hypotheses": {
      "$ref": "#/$defs/collection"
    },
    "attention": {
      "type": "object",
      "properties": {
        "quality": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "unavailable_observations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sources_requiring_review": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_validity_issues": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "quality",
        "unavailable_observations",
        "sources_requiring_review"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "coverage": {
            "enum": [
              "not_collected",
              "partial",
              "collected"
            ]
          },
          "missing_metrics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "dimension",
          "coverage",
          "missing_metrics"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "section",
          "argv"
        ],
        "additionalProperties": false
      }
    },
    "validity": {
      "type": "object"
    },
    "workflow": {
      "type": [
        "object",
        "null"
      ]
    },
    "execution_state_evidence": {
      "$ref": "#/$defs/collection"
    },
    "data_movement": {
      "type": "object",
      "required": [
        "schema_version",
        "columns",
        "unknowns",
        "possible_explanations",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "columns": {
          "type": "object",
          "required": [
            "outcome",
            "work",
            "data_movement"
          ]
        },
        "unknowns": {
          "type": "array"
        },
        "possible_explanations": {
          "type": "array"
        },
        "limitations": {
          "type": "array"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "record_id",
    "view_kind",
    "status",
    "error",
    "optimization_accepted",
    "subject",
    "assessment",
    "comparisons",
    "metrics",
    "hotspots",
    "hypotheses",
    "attention",
    "coverage",
    "limitations",
    "follow_up"
  ],
  "additionalProperties": false,
  "$defs": {
    "collection": {
      "type": "object",
      "required": [
        "items",
        "total",
        "returned",
        "omitted"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "omitted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
